{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "open-ldap-studio",
  "outputfilename": "open-ldap-studio",
  "frontend:install": "npm ci",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "wailsjsdir": "./frontend",
  "bindings": {
    "ts_generation": { "outputType": "interfaces" }
  },
  "info": {
    "companyName": "OLDAPS",
    "productName": "Open LDAP Studio",
    "productVersion": "0.1.0",
    "copyright": "Copyright © Open LDAP Studio contributors",
    "comments": "A cross-platform LDAP workbench."
  }
}
